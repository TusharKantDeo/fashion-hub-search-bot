# ---- LLM: any OpenAI-compatible endpoint ----
LLM_BASE_URL=https://api.together.xyz/v1
LLM_API_KEY=your-key-here
ROUTER_MODEL=Qwen/Qwen3.5-9B
ANSWER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# Together: turn off "thinking" so max_tokens=5 routers return a label, not reasoning
LLM_EXTRA_BODY={"reasoning": {"enabled": false}}
# OpenAI example:
# LLM_BASE_URL=https://api.openai.com/v1
# ROUTER_MODEL=gpt-4o-mini
# ANSWER_MODEL=gpt-4o
# LLM_EXTRA_BODY=
# Ollama example:
# LLM_BASE_URL=http://localhost:11434/v1
# ROUTER_MODEL=llama3.2:3b
# ANSWER_MODEL=llama3.1:8b

# ---- Embeddings (local, sentence-transformers) ----
EMBED_MODEL=BAAI/bge-base-en-v1.5

# ---- Weaviate: local | embedded | cloud ----
WEAVIATE_MODE=local
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_GRPC_PORT=50051
# WEAVIATE_MODE=embedded   (no Docker; data in WEAVIATE_DATA_PATH)
WEAVIATE_DATA_PATH=.weaviate-data
# WEAVIATE_MODE=cloud
# WEAVIATE_URL=https://xxxx.weaviate.cloud
# WEAVIATE_API_KEY=

# ---- Phoenix tracing ----
PHOENIX_ENABLED=true
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT=fashion-hub
